#!/bin/bash
#
# Listen to Internet Radio using MPlayer or VLC
# Original Author: Yu-Jie Lin
# Modified by: Jake Covert, 2025

# Define radio stations (name-command pairs)
stations=(
    'WDET'
    'vlc -I dummy https://wdet.cdnstream1.com/4550_256.aac'

    'WNYC - FM 93.9 : New York Public Radio'
    'vlc -I dummy https://fm939.wnyc.org/wnycfm'

    'WKSU Kent, Ohio'
    'vlc -I dummy http://wksu1.streamguys.com:8030/wksu1-256.aac'

    'WKSU 3 Classical - Kent, OH'
    'vlc -I dummy http://wksu1.streamguys.com:8030/wksu3-128'

    'WKSU - Akron, OH - Folk Alley'
    'vlc -I dummy https://freshgrass.streamguys1.com/folkalley-128mp3'

    'U of M College Radio (WCBN Ann Arbor)'
    'vlc -I dummy http://floyd.wcbn.org:8000/wcbn-hd.mp3'

    'Radio K - University of Minnesota, Minneapolis'
    'vlc -I dummy https://radiok.broadcasttool.stream/play_256'

    'KUAT Classical - Tucson, AZ'
    'vlc -I dummy https://streaming.azpm.org/kuat128.mp3'

    'Classical Minnesota Public Radio'
    'mplayer -msgcolor -playlist http://minnesota.publicradio.org/tools/play/streams/classical.pls'

    'KALX Radio 90.7FM - Berkeley, CA'
    'mplayer -msgcolor -playlist http://icecast.media.berkeley.edu:8000/kalx-128.mp3.m3u'

    'andHow.FM - Indie - New Zealand'
    'mplayer -msgcolor -playlist http://www.andhow.fm/playlists/andhow.m3u'

    'WRUV FM Burlington, VT 90.1'
    'mplayer -msgcolor -playlist http://wruv.org/wruv256.m3u'

    'Indie Pop Rocks [SomaFM]'
    'mplayer -msgcolor -playlist http://somafm.com/indiepop130.pls'

    'Digitalis [SomaFM]'
    'mplayer -msgcolor -playlist http://somafm.com/digitalis130.pls'

    'BAGeL Radio [SomaFM]'
    'mplayer -msgcolor -playlist http://somafm.com/bagel.pls'

    'KEXP.ORG 90.3FM - Seattle, WA'
    'mplayer -msgcolor -playlist http://live-mp3-128.kexp.org:8000/listen.pls'

    'BBC'
    'mplayer -msgcolor -playlist http://www.vpr.net/vpr_files/stream_playlists/vpr_bbc_mp3.pls'
)

# Total stations
station_count=$(( ${#stations[@]} / 2 ))

# If no argument, show station list
if [ -z "$1" ]; then
    echo "Internet Radio Stations:"
    for ((i = 0; i < station_count; i++)); do
        name_index=$((i * 2))
        echo "$i: ${stations[$name_index]}"
    done

    echo
    read -p "Which station? " radio
else
    radio=$1
fi

# Validate input
if ! [[ "$radio" =~ ^[0-9]+$ ]] || [ "$radio" -ge "$station_count" ]; then
    echo "Invalid selection. Exiting."
    exit 1
fi

# Run selected station command
cmd_index=$((radio * 2 + 1))
echo "Tuning in to: ${stations[$((radio * 2))]}"
eval "${stations[$cmd_index]}"
